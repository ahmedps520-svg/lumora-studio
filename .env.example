# ─────────────────────────────────────────────────────────────────────────────
# Lumora Studio — environment settings
#
# HOW TO USE: copy this file and name the copy ".env.local" (same folder).
# Fill in only what you want. Everything is optional — the app works without
# any keys; features that need a key simply switch off.
#
# .env.local is ignored by git, so your keys never get committed.
# Run `npm run check-env` to see what is switched on.
# ─────────────────────────────────────────────────────────────────────────────

# Claude API key (https://console.anthropic.com → API Keys). Powers all AI features.
# Server-side only — it is never sent to the browser.
ANTHROPIC_API_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey) — paints the artwork for
# Premium designs with Gemini image models ("Nano Banana"). Needs billing enabled
# (about $0.03–0.13 per image). Server-side only.
GEMINI_API_KEY=

# HD background removal runs on this server (free; downloads a ~224 MB model once).
# Leave empty for automatic (on, except on serverless hosts like Vercel), or set on / off.
BACKGROUND_REMOVAL_SERVER=

# Daily AI spending cap for the owner key, in US dollars. Default: 1
AI_DAILY_BUDGET_USD=1

# Max AI requests per visitor per minute. Default: 20
AI_RATE_LIMIT_PER_MINUTE=20

# Free stock photo APIs (optional — fill any you like)
# Accounts (log in / sign up). Locally everything works without these.
# BETTER_AUTH_SECRET: 32+ random characters (required in production), e.g. from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public address of the site, used in email links (e.g. https://lumora.example.com).
BETTER_AUTH_URL=
# Where accounts are stored (SQLite). Default: .data/lumora.db
AUTH_DATABASE_PATH=

# Email (Resend — https://resend.com/api-keys). Without a key, emails are printed in the
# dev server's terminal instead of being sent.
RESEND_API_KEY=
# Sender, from a domain you verified in Resend. Default: Resend's test sender, which can
# only email the address you signed up to Resend with.
EMAIL_FROM=

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional cloud sync with Supabase (free tier). Leave off to keep everything local.
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
